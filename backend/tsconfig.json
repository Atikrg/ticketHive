{
  "compilerOptions": {
    "target": "ES6", // or ESNext
    "module": "commonjs",
    "outDir": "./dist", // compiled JS goes here
    "rootDir": "./src", // your TS source
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}