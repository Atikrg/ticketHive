# Copy to .env and adjust. .env is gitignored, this template is not.

# Which environment the bundle is running as. Used for logging and diagnostics.
VITE_ENV_MODE=development

# Base URL the Socket.IO client connects to.
#   development: the backend dev server on its own origin
#   production:  leave empty so the client connects to the page origin
#                (nginx serves the bundle on :80 and proxies /socket.io/ to the backend)
VITE_SOCKET_URL=http://localhost:5000